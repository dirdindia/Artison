        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#131921"
      },
      "package": "com.digvijay108.ecommerceapp"
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "db22a171-09da-42e2-9587-b37ecbca9b77"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
